  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Configuration:\n",
      "  Tickers: NVDA, MU, AAPL, AMD, ASML, MSFT, GOOG\n",
      "  Date range: 2015-01-01 to 2025-11-01\n",
      "  Test split: 2023-09-01\n",
      "  Frequency: Weekly (1wk)\n",
      "  Features: 22 (minimal, evidence-based)\n",
      "  Output: /Users/nataliamarko/Documents/GitHub_Projects/reinforcement_learning_in_finance/rl_relabalance_portfolio/data/processed\n"
     ]
    }
   ],
   "source": [
    "# Directories\n",
    "PROJECT_ROOT = Path().resolve()\n",
    "DATA_DIR = PROJECT_ROOT / 'data' / 'processed'\n",
    "RESULTS_DIR = PROJECT_ROOT / 'results'\n",
    "\n",
    "DATA_DIR.mkdir(parents=True, exist_ok=True)\n",
    "RESULTS_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Data parameters\n",
    "TEST_START_DATE = '2023-09-01'\n",
    "\n",
    "print(\"Configuration:\")\n",
    "print(f\"  Tickers: {', '.join(TICKERS)}\")\n",
    "print(f\"  Date range: {START_DATE} to {END_DATE}\")\n",
    "print(f\"  Test split: {TEST_START_DATE}\")\n",
    "print(f\"  Frequency: Weekly (1wk)\")\n",
    "print(f\"  Features: 22 (minimal, evidence-based)\")\n",
    "print(f\"  Output: {DATA_DIR}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Run Data Preparation Pipeline\n",
    "\n",
    "Execute the complete pipeline:\n",
    "1. Fetch weekly price data from Yahoo Finance\n",
    "2. Calculate 22 minimal features\n",
    "3. Apply per-ticker rolling z-score normalization\n",
    "4. Split into train/test sets\n",
    "5. Save processed data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
