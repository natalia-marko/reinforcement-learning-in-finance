   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Load Training Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Loading training data...\n",
      "\n",
      "Data shape: (2989, 51)\n",
      "Date range: 2015-06-25 00:00:00 to 2023-08-24 00:00:00\n",
      "Tickers: ['AAPL', 'AMD', 'ASML', 'GOOG', 'MSFT', 'MU', 'NVDA']\n",
      "Weeks of data: 427\n",
      "\n",
      "✓ No NaN values in features\n",
      "\n",
