    "from utile import (\n",
    "    fetch_price_data, prepare_price_dataframe, fetch_macro_data,\n",
    "    engineer_all_features, preprocess_pipeline, fetch_benchmark_returns\n",
    ")\n",
    "\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)"
   ]
  },
  {
