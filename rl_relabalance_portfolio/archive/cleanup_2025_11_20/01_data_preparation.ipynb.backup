    "# Get feature columns\n",
    "non_feature_cols = ['date', 'ticker', 'open', 'high', 'low', 'close', 'volume']\n",
    "feature_cols = [c for c in train_df.columns if c not in non_feature_cols]\n",
    "\n",
    "# Verify data quality\n",
    "verify_data_quality(train_df, test_df, feature_cols)"
   ]
