   "source": [
    "# Update datasets and metadata with selected features\n",
    "train_df = train_df_filtered.copy()\n",
    "test_df = test_df_filtered.copy()\n",
    "\n",
    "metadata['feature_cols'] = top_features\n",
    "metadata['n_features'] = len(top_features)\n",
    "metadata['original_feature_count'] = len(feature_cols)\n",
    "metadata['selected_feature_count'] = len(top_features)\n",
    "feature_cols = top_features\n",
    "\n",
    "print(f\"✓ Updated: {len(feature_cols)} features selected\")"
   ]
