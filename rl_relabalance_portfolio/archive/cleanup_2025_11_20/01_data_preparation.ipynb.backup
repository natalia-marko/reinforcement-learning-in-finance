   "source": [
    "# Select top 100 features by importance\n",
    "TOP_N_FEATURES = 100\n",
    "\n",
    "top_features = feature_importance.head(TOP_N_FEATURES)['feature'].tolist()\n",
    "\n",
    "print(f\"Selecting top {TOP_N_FEATURES} features from {len(feature_cols)} total\\n\")\n",
    "print(\"=\" * 70)\n",
    "print(\"TOP 100 FEATURES BY IMPORTANCE\")\n",
    "print(\"=\" * 70)\n",
    "\n",
    "for i, (_, row) in enumerate(feature_importance.head(TOP_N_FEATURES).iterrows(), 1):\n",
    "    print(f\"{i:3d}. {row['feature']:40s} {row['importance']:.6f}\")\n",
    "\n",
    "# Filter dataframes\n",
    "non_feature_cols = ['date', 'ticker', 'open', 'high', 'low', 'close', 'volume']\n",
    "keep_cols = non_feature_cols + top_features\n",
    "\n",
    "train_df_filtered = train_df[[c for c in keep_cols if c in train_df.columns]]\n",
    "test_df_filtered = test_df[[c for c in keep_cols if c in test_df.columns]]\n",
    "\n",
    "print(f\"\\n✓ Filtered to {len(top_features)} features\")\n",
    "print(f\"  Train: {train_df_filtered.shape}\")\n",
    "print(f\"  Test: {test_df_filtered.shape}\")"
   ]
