    "print(f\"   - trajectory_*.csv (one per model)\")\n",
    "print(f\"\\n🏆 Best Model: {summary_df.iloc[0]['Model']} (Sharpe: {summary_df.iloc[0]['Test Sharpe']:.3f})\")"
